{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["candidates/**"],
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "never"
}
