{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-oracles/schemas/environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "execution",
    "browser",
    "renderer",
    "fonts",
    "locale",
    "timezone",
    "viewport",
    "devicePixelRatio",
    "colorProfile"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
    "execution": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "image"],
          "properties": {
            "kind": { "const": "container" },
            "image": {
              "type": "string",
              "pattern": "^.+@sha256:[0-9a-f]{64}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "architecture", "maximumVectorIsa"],
          "properties": {
            "kind": { "const": "native" },
            "architecture": { "type": "string", "minLength": 1 },
            "maximumVectorIsa": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "playwrightVersion", "revision"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "playwrightVersion": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "arguments"],
      "properties": {
        "implementation": { "type": "string", "minLength": 1 },
        "arguments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "sha256"],
        "properties": {
          "family": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "locale": { "type": "string", "minLength": 1 },
    "timezone": { "type": "string", "minLength": 1 },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "height": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 },
    "colorProfile": { "type": "string", "minLength": 1 }
  }
}
