{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-oracles/schemas/oracle-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "oracleCommit", "releaseTag", "manifestSha256", "packs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "repository": { "const": "flighthq/flight-oracles" },
    "oracleCommit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "releaseTag": { "type": "string", "pattern": "^oracle-[a-z0-9][a-z0-9-]*-[0-9a-f]{12}$" },
    "manifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "packs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "sha256"],
        "properties": {
          "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-oracle-.+\\.tgz$" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    }
  }
}
