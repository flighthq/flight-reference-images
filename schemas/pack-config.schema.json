{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-oracles/schemas/pack-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "subjects"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "subjects": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["defaultPack"],
        "properties": {
          "defaultPack": { "$ref": "common.schema.json#/$defs/identifier" },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pack", "entryPattern"],
              "properties": {
                "pack": { "$ref": "common.schema.json#/$defs/identifier" },
                "entryPattern": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
