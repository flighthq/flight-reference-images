{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-oracles/schemas/candidate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "environmentId", "comparisonPolicyId", "captures"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "requestId": { "$ref": "common.schema.json#/$defs/identifier" },
    "environmentId": {
      "type": "string",
      "pattern": "^sha256-[0-9a-f]{64}$"
    },
    "comparisonPolicyId": { "$ref": "common.schema.json#/$defs/identifier" },
    "captures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "identity", "file", "provenance"],
            "properties": {
              "status": { "const": "captured" },
              "identity": { "$ref": "common.schema.json#/$defs/identity" },
              "file": {
                "type": "string",
                "pattern": "^images/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*\\.png$"
              },
              "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "identity", "error"],
            "properties": {
              "status": { "const": "missing" },
              "identity": { "$ref": "common.schema.json#/$defs/identity" },
              "error": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        ]
      }
    }
  }
}
