{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "subject", "targets", "frames", "reason"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "subject": { "$ref": "common.schema.json#/$defs/identifier" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "renderers"],
        "properties": {
          "entry": { "$ref": "common.schema.json#/$defs/identifier" },
          "renderers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "$ref": "common.schema.json#/$defs/identifier" }
          }
        }
      }
    },
    "frames": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
