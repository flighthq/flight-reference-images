{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "subject", "targets", "frames", "reason"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 3 },
    "id": { "$ref": "common.schema.json#/$defs/identifier" },
    "subject": { "$ref": "common.schema.json#/$defs/identifier" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "renderer", "pixelSha256", "build", "capture"],
        "properties": {
          "entry": { "$ref": "common.schema.json#/$defs/identifier" },
          "renderer": { "$ref": "common.schema.json#/$defs/identifier" },
          "pixelSha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "build": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "dirty", "dirtyOmitted"],
            "properties": {
              "commit": { "$ref": "common.schema.json#/$defs/gitCommit" },
              "dirty": {
                "type": "array",
                "maxItems": 1000,
                "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
              },
              "dirtyOmitted": { "type": "integer", "minimum": 0 }
            }
          },
          "capture": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostInstanceId", "environmentId"],
            "properties": {
              "hostInstanceId": { "type": "string", "minLength": 1, "maxLength": 200 },
              "environmentId": {
                "type": "string",
                "pattern": "^sha256-[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "frames": { "type": "integer", "minimum": 1 },
    "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
  }
}
