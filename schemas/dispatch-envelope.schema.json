{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/dispatch-envelope.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "flightCommit",
    "requestPath",
    "requestSha256",
    "artifactId",
    "workflowRunId",
    "artifactDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "flighthq/flight" },
    "flightCommit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "requestPath": {
      "type": "string",
      "pattern": "^reference-image-requests/[a-z0-9][a-z0-9-]*\\.json$"
    },
    "requestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "artifactId": { "type": "integer", "minimum": 1 },
    "workflowRunId": { "type": "integer", "minimum": 1 },
    "artifactDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "flightCommittedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
