{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/prepared-intake.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseTag",
    "baseManifestSha256",
    "baseRecordsSha256",
    "candidateSha256",
    "requestSha256",
    "envelopeSha256",
    "expectedManifestSha256",
    "records",
    "packs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseTag": { "type": "string", "pattern": "^oracle-[a-z0-9][a-z0-9-]*-[0-9a-f]{12}$" },
    "baseManifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "baseRecordsSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "candidateSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "requestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "envelopeSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "expectedManifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^oracles/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*\\.json$"
          },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "sha256", "size", "imageCount"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/identifier" },
          "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-oracle-.+\\.tgz$" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 1 },
          "imageCount": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
