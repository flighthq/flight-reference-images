{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/dispatch-batch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "flightCommit", "workflowRunId", "candidates"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "repository": { "const": "flighthq/flight" },
    "flightCommit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "workflowRunId": { "type": "integer", "minimum": 1 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestPath", "requestSha256", "artifactId", "artifactDigest"],
        "properties": {
          "requestPath": {
            "type": "string",
            "pattern": "^reference-image-requests/[a-z0-9][a-z0-9-]*\\.json$"
          },
          "requestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "artifactId": { "type": "integer", "minimum": 1 },
          "artifactDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
