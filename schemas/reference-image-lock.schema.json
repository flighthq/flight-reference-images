{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flighthq/flight-reference-images/schemas/reference-image-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "oracleCommit", "releaseTag", "manifestSha256", "packs"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "repository": { "const": "flighthq/flight-reference-images" },
    "oracleCommit": { "$ref": "common.schema.json#/$defs/gitCommit" },
    "releaseTag": { "type": "string", "pattern": "^oracle-[a-z0-9][a-z0-9-]*-[0-9a-f]{12}$" },
    "manifestSha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "packs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "images", "sha256"],
        "properties": {
          "file": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*-oracle-.+\\.tgz$" },
          "images": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pixelSha256"],
              "properties": {
                "pixelSha256": { "$ref": "common.schema.json#/$defs/sha256" }
              }
            }
          },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" }
        }
      }
    }
  }
}
